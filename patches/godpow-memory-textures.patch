+    // uploads made (Mario Kart World loading a course) for many seconds, on a phone whose GPU
+    // memory is its RAM.
+    auto& cache = GetCache(usage);
+    for (size_t log2 = 0; log2 < NUM_LEVELS; ++log2) {
