From 8c8a152e828e56e95218cb4fac06ea46c9d8de50 Mon Sep 17 00:00:00 2001
From: godpow <17231911+godpow@users.noreply.github.com>
Date: Sun, 1 Nov 2026 02:50:30 -0500
Subject: [PATCH 05/18] kernel: Give freed guest memory back to the host

Pages whose last reference went returned to the kernel's free lists
but stayed resident on the host until reused. Mario Kart World's guest
memory grew with every course it loaded, the previous courses' memory
freed but resident, until a phone killed it moving on to the third.

KMemoryManager::Close now releases the backing of runs of 16 or more
freed pages (punching a hole in the memfd), under the pool lock before
they can be allocated again. They read as zero, which freed memory may.

Assisted-by: Claude Opus 5.5 (implementation and debugging)
(cherry picked from commit 9718e3b32da8486bfe03041c7b0c6ac0efa03b37)
---
 src/core/hle/kernel/k_memory_manager.cpp | 12 ++++++++++++
 src/core/hle/kernel/k_memory_manager.h   | 21 +++++++++++++++++----
 2 files changed, 29 insertions(+), 4 deletions(-)

diff --git a/src/core/hle/kernel/k_memory_manager.cpp b/src/core/hle/kernel/k_memory_manager.cpp
index bed3dd819..b6606fd29 100644
--- a/src/core/hle/kernel/k_memory_manager.cpp
+++ b/src/core/hle/kernel/k_memory_manager.cpp
@@ -450,6 +450,18 @@ Result KMemoryManager::AllocateForProcess(KPageGroup* out, size_t num_pages, u32
     R_SUCCEED();
 }
 
+void KMemoryManager::ReleaseFreedPages(KPhysicalAddress address, size_t num_pages) {
+    // Freed guest memory stayed resident until reused: Mario Kart World's memory grew with every
+    // course it loaded (the last ones' regions freed but resident) until a phone killed it on the
+    // third. Small runs (thread stacks and the like) are left, not worth the system call.
+    constexpr size_t MinPages = 16;
+    if (num_pages < MinPages) {
+        return;
+    }
+    m_system.DeviceMemory().buffer.ReleaseBackingRegion(
+        GetInteger(address) - Core::DramMemoryMap::Base, num_pages * PageSize);
+}
+
 size_t KMemoryManager::Impl::Initialize(KPhysicalAddress address, size_t size,
                                         KVirtualAddress management, KVirtualAddress management_end,
                                         Pool p) {
diff --git a/src/core/hle/kernel/k_memory_manager.h b/src/core/hle/kernel/k_memory_manager.h
index 66b97fef8..42cc14432 100644
--- a/src/core/hle/kernel/k_memory_manager.h
+++ b/src/core/hle/kernel/k_memory_manager.h
@@ -110,7 +110,9 @@ public:
 
             {
                 KScopedLightLock lk(m_pool_locks[static_cast<size_t>(manager.GetPool())]);
-                manager.Close(address, cur_pages);
+                manager.Close(address, cur_pages, [this](KPhysicalAddress freed, size_t count) {
+                    ReleaseFreedPages(freed, count);
+                });
             }
 
             num_pages -= cur_pages;
@@ -291,12 +293,19 @@ private:
             }
         }
 
-        void Close(KPhysicalAddress address, size_t num_pages) {
+        // `on_free` sees each run of pages whose last reference went, before they're free.
