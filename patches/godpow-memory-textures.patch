From ffa68f3c66281a848417375e59e8f20d589ed2e5 Mon Sep 17 00:00:00 2001
From: godpow <17231911+godpow@users.noreply.github.com>
Date: Tue, 3 Nov 2026 22:36:10 -0500
Subject: [PATCH 10/18] vk_staging_buffer_pool: recheck region 0 after a wrap
 that fell back

When the stream buffer wraps, GetStreamBuffer checks regions 0 to
Region(size) and, if the GPU still uses them, hands out a staging buffer
instead. It left iterator 0 and free_iterator `size` behind, though: the
next request of that size or smaller checked the empty range
[Region(size) + 1, Region(size) + 1) and got offset 0 while the GPU was
still reading region 0, so the upload overwrote data in use (vertex,
index and constant data drawn wrong for that frame).

The fallback now sets free_iterator to 0, and a free_iterator of 0 makes
the next request check from region 0 itself.

Assisted-by: Claude Opus 5.5 (implementation and debugging)
---
 src/video_core/renderer_vulkan/vk_staging_buffer_pool.cpp | 8 ++++++--
 1 file changed, 6 insertions(+), 2 deletions(-)

diff --git a/src/video_core/renderer_vulkan/vk_staging_buffer_pool.cpp b/src/video_core/renderer_vulkan/vk_staging_buffer_pool.cpp
index 4864e8a1e..d1df679c9 100644
--- a/src/video_core/renderer_vulkan/vk_staging_buffer_pool.cpp
+++ b/src/video_core/renderer_vulkan/vk_staging_buffer_pool.cpp
@@ -142,7 +142,8 @@ void StagingBufferPool::TickFrame() {
 }
 
 StagingBufferRef StagingBufferPool::GetStreamBuffer(size_t size) {
-    if (AreRegionsActive(Region(free_iterator) + 1,
+    // free_iterator 0: nothing is known free yet, region 0 included (see the wrap below).
+    if (AreRegionsActive(free_iterator == 0 ? 0 : Region(free_iterator) + 1,
                          (std::min)(Region(iterator + size) + 1, NUM_SYNCS))) {
         // Avoid waiting for the previous usages to be free
         return GetStagingBuffer(size, MemoryUsage::Upload);
@@ -161,7 +162,10 @@ StagingBufferRef StagingBufferPool::GetStreamBuffer(size_t size) {
         free_iterator = size;
 
         if (AreRegionsActive(0, Region(size) + 1)) {
-            // Avoid waiting for the previous usages to be free
+            // Avoid waiting for the previous usages to be free. Region 0 is still in use: with
+            // free_iterator at `size`, a next request this size or smaller skipped the check and
+            // got offset 0 while the GPU still read it. The next request checks region 0 again.
+            free_iterator = 0;
             return GetStagingBuffer(size, MemoryUsage::Upload);
         }
     }
