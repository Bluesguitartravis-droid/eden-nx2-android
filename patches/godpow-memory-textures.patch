From df168e00346363b331d77f12e2edbb0794d918cb Mon Sep 17 00:00:00 2001
From: ZnOw01 <ZnOw01@users.noreply.github.com>
Date: Sat, 31 Oct 2026 11:02:42 -0500
Subject: [PATCH 01/18] video_core: bound macro binds and discard misparsed
 host blocks

Maxwell3D::ProcessMacroBind wrote positions[start_address_ptr++] without
checking the index. A misparsed pushbuffer produced indices like
0x3a400040 and 0x81500e36 against the 0x80-entry table, writing gigabytes
past it and crashing the GPU thread.

Bound the index and drop the write, and when the host class reaches the
illegal method 0x1, discard the rest of that command block using its
declared count instead of executing thousands of bogus methods. The skip
survives entry boundaries so the next header parses aligned.

Also record the failing instruction's PC in the macro JIT; it stayed
zero, hiding where the JIT gave up.

Assisted-by: Hermes Agent (AI-assisted analysis and patch)
(cherry picked from commit eafb2d64faa5a1ee0f40916d43f8f9a91efb082c)
(cherry picked from commit 3b547986fc5b4933f55dcbe25c9f88043ed2104f)
---
 src/video_core/dma_pusher.cpp         | 30 +++++++++++++++++++++++++++
 src/video_core/dma_pusher.h           |  1 +
 src/video_core/engines/maxwell_3d.cpp | 11 ++++++++--
 src/video_core/macro.cpp              |  5 +++--
 src/video_core/macro_turing_jit.h     |  2 ++
 5 files changed, 45 insertions(+), 4 deletions(-)

diff --git a/src/video_core/dma_pusher.cpp b/src/video_core/dma_pusher.cpp
index 391226c9f..248a7154a 100644
--- a/src/video_core/dma_pusher.cpp
+++ b/src/video_core/dma_pusher.cpp
@@ -268,6 +268,9 @@ bool DmaPusher::Step() {
             }
         }
         parked_methods.clear();
+        // A rejected block cannot continue past its submission; do not let its skip eat the
+        // headers of the next one.
+        dma_state.skip_words = 0;
         dma_pushbuffer.pop_front();
         dma_pushbuffer_subindex = 0;
     } else {
@@ -299,6 +302,16 @@ static const bool g_record_parsed_entries = std::getenv("EDEN_NX2_PB_CHECK") !=
 
 size_t DmaPusher::ProcessCommands(std::span<const CommandHeader> commands, size_t word_offset) {
     for (size_t index = 0; index < commands.size();) {
+        // Discard the rest of a command block that was rejected (illegal method). The block's
+        // declared count still tells where the next header starts, so the stream stays aligned
+        // instead of running thousands of bogus methods.
+        if (dma_state.skip_words != 0) {
+            const u32 skip =
+                static_cast<u32>(std::min<std::size_t>(dma_state.skip_words, commands.size() - index));
+            index += skip;
+            dma_state.skip_words -= skip;
+            continue;
+        }
         // Data word of methods command
         if (dma_state.method_count && dma_state.non_incrementing) {
             auto const& command_header = commands[index]; //must ref (MUltiMethod re)
@@ -453,6 +466,23 @@ bool DmaPusher::WantsSegment() const {
 }
 
 void DmaPusher::CallMethod(u32 argument) {
+    // Method 0x1 is illegal in the host class: a stream that reaches it has been misparsed (for
+    // example, a split method continued into a different command buffer). Discard the rest of
+    // the block using its declared count instead of running thousands of bogus methods against
+    // the engines; the next header then parses from an aligned position.
+    if (dma_state.method == static_cast<u32>(BufferMethods::Illegal)) {
+        const u32 remaining = dma_state.method_count > 0 ? dma_state.method_count - 1 : 0;
+        static std::atomic<u32> reported{};
+        if (reported.fetch_add(1) < 8) {
+            LOG_ERROR(HW_GPU,
+                      "Illegal host method on subchannel {}: discarding {} words of the block",
+                      dma_state.subchannel, remaining);
+        }
+        dma_state.skip_words = remaining;
+        dma_state.method_count = 1;
+        dma_state.non_incrementing = false;
+        return;
+    }
     if (g_semaphore_watch != 0) [[unlikely]] {
         WatchArgument(dma_state.method, argument);
     }
diff --git a/src/video_core/dma_pusher.h b/src/video_core/dma_pusher.h
index 8c85eb368..faa80c0e1 100644
--- a/src/video_core/dma_pusher.h
+++ b/src/video_core/dma_pusher.h
@@ -250,6 +250,7 @@ public:
         u32 subchannel;        ///< Current subchannel
         u32 method_count;      ///< Current method count
         u32 length_pending;    ///< Large NI command length pending
+        u32 skip_words;        ///< Words left to discard from an invalid command block
         GPUVAddr dma_get;      ///< Currently read segment
         u64 dma_word_offset;   ///< Current word offset from address
         bool non_incrementing; ///< Current command's NI flag
diff --git a/src/video_core/engines/maxwell_3d.cpp b/src/video_core/engines/maxwell_3d.cpp
index 25ba8cc21..0c6d9c63b 100644
--- a/src/video_core/engines/maxwell_3d.cpp
+++ b/src/video_core/engines/maxwell_3d.cpp
@@ -765,9 +765,16 @@ void Maxwell3D::ProcessMacroUpload(u32 data) {
 void Maxwell3D::ProcessMacroBind(u32 data) {
     const auto positions = GetNativeMacroPositions();
     const u32 index = regs.load_mme.start_address_ptr++;
-    if (index < positions.size()) {
-        positions[index] = data;
+    if (index >= positions.size()) {
+        static std::atomic<u32> rejected{};
+        if (rejected.fetch_add(1) < 8) {
+            LOG_ERROR(HW_GPU,
+                      "Rejecting out-of-range macro bind: index={:#x}, entries={}, data={:#x}",
+                      index, positions.size(), data);
+        }
+        return;
     }
+    positions[index] = data;
 }
 
 void Maxwell3D::ProcessFirmwareCall4() {
diff --git a/src/video_core/macro.cpp b/src/video_core/macro.cpp
index 32916d4af..cc32c9a31 100644
--- a/src/video_core/macro.cpp
+++ b/src/video_core/macro.cpp
@@ -1510,8 +1510,9 @@ void MacroEngine::Execute(Core::System& system, Engines::Maxwell3D& maxwell3d, u
                 emit);
             if (!result.success) {
                 native_execution_failed = true;
-                LOG_ERROR(HW_GPU, "Native MME (JIT) failed: start={:#x}, consumed={}/{}, error={}",
-                          method, result.consumed, parameters.size(), result.error);
+                LOG_ERROR(HW_GPU,
+                          "Native MME (JIT) failed: start={:#x}, pc={:#x}, consumed={}/{}, error={}",
+                          method, result.pc, result.consumed, parameters.size(), result.error);
             }
             return;
         }
diff --git a/src/video_core/macro_turing_jit.h b/src/video_core/macro_turing_jit.h
index bb24bc948..d0b591a4f 100644
--- a/src/video_core/macro_turing_jit.h
+++ b/src/video_core/macro_turing_jit.h
@@ -304,6 +304,8 @@ private:
         }
 
         void Instruction(Word pc, Word count, const Decoded& d) {
+            // Keep the failing PC available for diagnostics; it used to stay zero.
+            mov(dword[st + offsetof(State, fail_pc)], pc);
             // FIFO loads, in lane order.
             for (Word i = 0; i < 2; ++i) {
                 const Xbyak::Reg32 load = i == 0 ? r12d : r13d;
