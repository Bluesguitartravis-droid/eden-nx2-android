From 7e0d96c44261d12081c79f7a5a8955602a6066da Mon Sep 17 00:00:00 2001
From: godpow <17231911+godpow@users.noreply.github.com>
Date: Sat, 31 Oct 2026 06:40:35 -0400
Subject: [PATCH 02/18] texture_cache: use the null image for textures the host
 cannot create

Mario Kart World's 8192x8192x68 BC6H virtual texture is 6 GB; the
Adreno driver refuses allocations over 4 GB and has no real sparse
images, so even the unbacked fallback fails. The exception hit
SlotVector::insert's noexcept and terminated. insert now frees the slot
and rethrows; JoinImages returns no image, which the callers (image
views, render targets, blits) treat as unmapped, and the null image is
never prepared for upload.

Assisted-by: Claude Opus 5.5 (implementation and debugging)
(cherry picked from commit c79b93ba11650d2e28ca7bc681847631a1e9637a)
---
 src/common/slot_vector.h                     | 11 +++++--
 src/video_core/texture_cache/texture_cache.h | 32 ++++++++++++++++++--
 2 files changed, 39 insertions(+), 4 deletions(-)

diff --git a/src/common/slot_vector.h b/src/common/slot_vector.h
index 2e3d6b23f..52c40b9c1 100644
--- a/src/common/slot_vector.h
+++ b/src/common/slot_vector.h
@@ -124,9 +124,16 @@ public:
     }
 
     template <typename... Args>
-    [[nodiscard]] SlotId insert(Args&&... args) noexcept {
+    [[nodiscard]] SlotId insert(Args&&... args) {
         const u32 index = FreeValueIndex();
-        new (&values[index].object) T(std::forward<Args>(args)...);
+        try {
+            new (&values[index].object) T(std::forward<Args>(args)...);
+        } catch (...) {
+            // A constructor may throw (a texture the GPU cannot allocate): keep the slot free and
+            // let the caller handle it, instead of terminating at a noexcept boundary.
+            free_list.push_back(index);
+            throw;
+        }
         SetStorageBit(index);
 
         return SlotId{index};
diff --git a/src/video_core/texture_cache/texture_cache.h b/src/video_core/texture_cache/texture_cache.h
index 917e5e688..14a2b44ec 100644
--- a/src/video_core/texture_cache/texture_cache.h
+++ b/src/video_core/texture_cache/texture_cache.h
@@ -2556,6 +2556,9 @@ ImageId TextureCache<P>::InsertImage(const ImageInfo& info, GPUVAddr gpu_addr,
                  static_cast<u32>(info.format), info.block.width, info.block.height, info.block.depth);
     }
     const ImageId image_id = JoinImages(storage_info, gpu_addr, *cpu_addr);
+    if (!image_id) {
+        return ImageId{}; // Could not be created (see JoinImages)
+    }
     const Image& image = slot_images[image_id];
     // Using "image.gpu_addr" instead of "gpu_addr" is important because it might be different
     const auto [it, is_new] = image_allocs_table.try_emplace(image.gpu_addr);
@@ -2677,7 +2680,21 @@ ImageId TextureCache<P>::JoinImages(const ImageInfo& info, GPUVAddr gpu_addr, DA
             }
         }
     }
-    const ImageId new_image_id = slot_images.insert(runtime, new_info, gpu_addr, cpu_addr);
+    ImageId new_image_id;
+    try {
+        new_image_id = slot_images.insert(runtime, new_info, gpu_addr, cpu_addr);
+    } catch (const std::exception& e) {
+        // The host cannot hold it at all: an 8192x8192x68 BC6H virtual texture is 6 GB on a
+        // driver with a 4 GB allocation limit and no real sparse images (Adreno). Sample it as
+        // the null image rather than aborting; nothing has been joined into it yet.
+        static u32 logged{};
+        if (logged++ < 16) {
+            LOG_ERROR(HW_GPU, "Image {}x{}x{} ({} levels) at {:#x} could not be created ({}); using the null image",
+                      new_info.size.width, new_info.size.height, new_info.resources.layers,
+                      new_info.resources.levels, gpu_addr, e.what());
+        }
+        return ImageId{};
+    }
     Image& new_image = slot_images[new_image_id];
 
     new_image.allocation_tick = frame_tick;
@@ -2923,6 +2940,9 @@ std::optional<typename TextureCache<P>::BlitImages> TextureCache<P>::GetBlitImag
             dst_id = InsertImage(dst_info, dst_addr, RelaxedOptions{});
         }
     } while (has_deleted_images);
+    if (!src_id || !dst_id) {
+        return std::nullopt; // An image that could not be created (see JoinImages)
+    }
     const ImageBase& src_image = slot_images[src_id];
     const ImageBase& dst_image = slot_images[dst_id];
     const bool native_bgr = runtime.HasNativeBgr();
@@ -2938,6 +2958,9 @@ std::optional<typename TextureCache<P>::BlitImages> TextureCache<P>::GetBlitImag
             src_id = FindOrInsertImage(src_info, src_addr, RelaxedOptions{});
             dst_id = FindOrInsertImage(dst_info, dst_addr, RelaxedOptions{});
         } while (has_deleted_images);
+        if (!src_id || !dst_id) {
+            return std::nullopt;
+        }
     }
     return {BlitImages{
         .dst_id = dst_id,
@@ -3685,6 +3708,9 @@ void TextureCache<P>::SynchronizeAliases(ImageId image_id) {
 
 template <class P>
 void TextureCache<P>::PrepareImage(ImageId image_id, bool is_modification, bool invalidate) {
+    if (image_id == NULL_IMAGE_ID) {
+        return; // See PrepareImageView
+    }
     Image& image = slot_images[image_id];
     if (invalidate) {
         image.flags &= ~(ImageFlagBits::CpuModified | ImageFlagBits::GpuModified);
@@ -3739,7 +3765,9 @@ void TextureCache<P>::PrepareImage(ImageId image_id, bool is_modification, bool
 template <class P>
 void TextureCache<P>::PrepareImageView(ImageViewId image_view_id, bool is_modification,
                                        bool invalidate) {
-    if (!image_view_id) {
+    // The null view stands for textures that are unmapped or could not be created: it has no
+    // contents to upload (its image's format is invalid).
+    if (!image_view_id || image_view_id == NULL_IMAGE_VIEW_ID) {
         return;
     }
     const ImageViewBase& image_view = slot_image_views[image_view_id];
