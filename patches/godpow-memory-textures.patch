From e53fbbb938cd96adcda46a14d8c56c5d7e9e4ce3 Mon Sep 17 00:00:00 2001
From: godpow <17231911+godpow@users.noreply.github.com>
Date: Sun, 1 Nov 2026 00:55:23 -0400
Subject: [PATCH 03/18] vulkan_device: memory use and budget without
 VK_EXT_memory_budget

Qualcomm's driver has no VK_EXT_memory_budget. The texture cache then
summed its images' sizes for its memory use, counting sparse and unbacked
images whole. Its budget was the 4 GiB integrated default. In Mario Kart
World it "used" 8.5 GB with 4.7 GB allocated, far past its critical 3.8
GB, and evicted textures nonstop. The process grew to 15-18 GB until
Android killed it while loading each race.

Without the extension, the usage is now what VMA's allocations use. On
an integrated GPU, the budget is a quarter of the system's RAM, and at
least 4 GiB: about 6 GiB on a 24 GiB phone, near what Turnip's budget
gives there.

Assisted-by: Claude Opus 5.5 (implementation and debugging)
(cherry picked from commit 869d8df55071760e0301a1c4f081f00324478e11)
---
 .../vulkan_common/vulkan_device.cpp           | 25 ++++++++++++++++++-
 src/video_core/vulkan_common/vulkan_device.h  |  3 ++-
 2 files changed, 26 insertions(+), 2 deletions(-)

diff --git a/src/video_core/vulkan_common/vulkan_device.cpp b/src/video_core/vulkan_common/vulkan_device.cpp
index d28dd131e..e69f3d181 100644
--- a/src/video_core/vulkan_common/vulkan_device.cpp
+++ b/src/video_core/vulkan_common/vulkan_device.cpp
@@ -24,6 +24,7 @@
 #include "common/fs/fs.h"
 #include "common/fs/path_util.h"
 #include "common/literals.h"
+#include "common/memory_detect.h"
 #include <ranges>
 #include "common/settings.h"
 #include "common/settings_enums.h"
@@ -1727,6 +1728,21 @@ void Device::ReleaseCustomBorderColorSamplers(size_t count) const {
 }
 
 u64 Device::GetDeviceMemoryUsage() const {
+    // Without VK_EXT_memory_budget (Qualcomm's driver), what VMA's allocations use. The caches'
+    // own estimate counted sparse and unbacked images at their full size: Mario Kart World
+    // "used" 8.5 GB with 4.7 GB allocated, and evicted textures nonstop until the phone ran out of
+    // memory.
+    if (!extensions.memory_budget) {
+        u64 used{};
+        if (allocator != nullptr) {
+            std::array<VmaBudget, VK_MAX_MEMORY_HEAPS> heap_budgets{};
+            vmaGetHeapBudgets(allocator, heap_budgets.data());
+            for (const size_t heap : valid_heap_memory) {
+                used += heap_budgets[heap].statistics.allocationBytes;
+            }
+        }
+        return used;
+    }
     VkPhysicalDeviceMemoryBudgetPropertiesEXT budget{};
     budget.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT;
     physical.GetMemoryProperties(&budget);
@@ -1753,7 +1769,14 @@ u64 Device::GetDeviceMemorySlack() const {
 
 u64 Device::GetDeviceMemoryBudget() const {
     if (!extensions.memory_budget) {
-        return 0;
+        // A phone GPU without the extension shares the system's RAM: a quarter of it (at least
+        // 4 GiB), ~6 GiB on a 24 GiB phone, what Turnip's budget gives on the same one. The
+        // integrated default of 4 GiB was under what Mario Kart World keeps in use.
+        if (!is_integrated) {
+            return 0;
+        }
+        const u64 quarter = Common::GetMemInfo().TotalPhysicalMemory / 4;
+        return (std::max<u64>)(quarter, u64{4} << 30);
     }
     VkPhysicalDeviceMemoryBudgetPropertiesEXT budget{};
     budget.sType = VK_STRUCTURE_TYPE_PHYSICAL_DEVICE_MEMORY_BUDGET_PROPERTIES_EXT;
diff --git a/src/video_core/vulkan_common/vulkan_device.h b/src/video_core/vulkan_common/vulkan_device.h
index 93a89d124..385e72ef4 100644
--- a/src/video_core/vulkan_common/vulkan_device.h
+++ b/src/video_core/vulkan_common/vulkan_device.h
@@ -1038,8 +1038,9 @@ FN_MAX_LIMIT_LIST
         return device_access_memory;
     }
 
+    /// With VK_EXT_memory_budget from the driver, or VMA's allocations without it.
     bool CanReportMemoryUsage() const {
-        return extensions.memory_budget;
+        return extensions.memory_budget || allocator != nullptr;
     }
 
     u64 GetDeviceMemoryUsage() const;
-- 
