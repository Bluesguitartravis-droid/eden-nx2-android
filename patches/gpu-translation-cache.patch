From 1c143b26a413e55b729af40413d7ccb0ef7be9bb Mon Sep 17 00:00:00 2001
From: kraibse <33869366+kraibse@users.noreply.github.com>
Date: Mon, 9 Nov 2026 19:09:25 +0100
Subject: [PATCH] video_core: cache GPU page translations per thread

MemoryManager::GpuToCpuAddress looks up the same few pages over and over (each draw rebinds
its buffers and textures). A small per-thread cache of 4 KiB page translations, tagged with
the manager and its map serial (which moves after every map or unmap), answers the repeats.
EDEN_NX2_NO_TRANSLATION_CACHE=1 turns it off.

OoT Kokiri spawn, lab: back thread CPU 13.64 -> 13.25 ms per frame.

Assisted-by: Claude Sonnet 5.5 (implementation and measurement)
(cherry picked from commit b1e650849e71c85b60c6d794a4cb36e6bdf8455f)
(cherry picked from commit 3b7b2576f45d969a87486a95091d1f0d69ecfe48)
---
 src/video_core/memory_manager.cpp | 44 ++++++++++++++++++++++++-------
 1 file changed, 35 insertions(+), 9 deletions(-)

diff --git a/src/video_core/memory_manager.cpp b/src/video_core/memory_manager.cpp
index 34d907eb07..d3676da6a5 100644
--- a/src/video_core/memory_manager.cpp
+++ b/src/video_core/memory_manager.cpp
@@ -282,22 +282,48 @@ std::optional<DAddr> MemoryManager::GpuToCpuAddress(GPUVAddr gpu_addr) const {
     if (!IsWithinGPUAddressRange(gpu_addr)) [[unlikely]] {
         return std::nullopt;
     }
-    DAddr dev_addr;
+    // The same few pages are looked up over and over (every draw rebinds its buffers and
+    // textures): a small per-thread cache of page translations, dropped whenever any entry
+    // changes (map_serial moves after each map or unmap). EDEN_NX2_NO_TRANSLATION_CACHE=1
+    // turns it off.
+    struct CachedPage {
+        u64 owner;
+        u64 serial;
+        u64 page;
+        u64 device_page;
+    };
+    static constexpr size_t CacheSize = 2048;
+    static thread_local std::array<CachedPage, CacheSize> cache{};
+    static const bool use_cache = std::getenv("EDEN_NX2_NO_TRANSLATION_CACHE") == nullptr;
+    constexpr u64 SubpageBits = 12;
+    constexpr u64 SubpageMask = (u64{1} << SubpageBits) - 1;
+    const u64 owner_id = (u64{unique_identifier} << 1) | 1; // Never 0, the empty slot
+    const u64 page = gpu_addr >> SubpageBits;
+    const u64 serial = map_serial.load(std::memory_order_acquire);
+    CachedPage& slot = cache[(page ^ (page >> 11)) % CacheSize];
+    if (use_cache && slot.owner == owner_id && slot.page == page && slot.serial == serial) [[likely]] {
+        return slot.device_page + (gpu_addr & SubpageMask);
+    }
+    std::optional<DAddr> result;
     if (GetEntry(gpu_addr, true) != EntryType::Mapped) [[unlikely]] {
-        if (GetEntry(gpu_addr, false) != EntryType::Mapped)
+        if (GetEntry(gpu_addr, false) != EntryType::Mapped) {
             return std::nullopt;
-        dev_addr = (DAddr(page_table[PageEntryIndex(gpu_addr, false)]) << cpu_page_bits) +
-                   (gpu_addr & page_mask);
+        }
+        const DAddr dev_addr_base = DAddr(page_table[PageEntryIndex(gpu_addr, false)]) << cpu_page_bits;
+        result = dev_addr_base + (gpu_addr & page_mask);
     } else {
-        dev_addr = (DAddr(big_page_table_dev[PageEntryIndex(gpu_addr, true)]) << cpu_page_bits) +
-                   (gpu_addr & big_page_mask);
+        const DAddr dev_addr_base = DAddr(big_page_table_dev[PageEntryIndex(gpu_addr, true)]) << cpu_page_bits;
+        result = dev_addr_base + (gpu_addr & big_page_mask);
     }
-    if ((dev_addr >> MaxwellDeviceMemoryManager::AS_BITS) != 0) {
+    if ((*result >> MaxwellDeviceMemoryManager::AS_BITS) != 0) {
         LOG_ERROR(HW_GPU, "GPU address {:#x} maps outside the device space, to {:#x}", gpu_addr,
-                  dev_addr);
+                  *result);
         return std::nullopt;
     }
-    return dev_addr;
+    if (use_cache) {
+        slot = CachedPage{owner_id, serial, page, *result - (gpu_addr & SubpageMask)};
+    }
+    return result;
 }
 
 std::optional<DAddr> MemoryManager::GpuToCpuAddress(GPUVAddr addr, std::size_t size) const {
