Subject: [PATCH 7/9] video_core: the back notes a sync once between reads of
 the sync serial

Every method of an engine other than 3D breaks fast draws with OtherEngine, and each break did a
locked add on Nx2FastDraw::g_sync_serial, a cache line the front's puller also writes: 3.4% of the
GPU back thread at Ocarina of Time's Market. The thread that reads the sync serial (uniform keeps
on the back) now skips the add once it bumped it since its read, as fast draw breaks already do
for the draw serial (#1161). The reader only compares for a change, so it sees the same syncs.
g_enabled gets its own cache line, as the comment on g_serial assumed.

Port of tasarren/Lichii efa41e4240 (Tasa).

Co-authored-by: capy-ai[bot] <230910855+capy-ai[bot]@users.noreply.github.com>
(cherry picked from commit eb898f212d7f9ba91885cac1e24f681137f0bbc0)
---
 src/tests/video_core/fast_draw.cpp | 23 +++++++++++++++++++++++
 src/video_core/nx2_fast_draw.h     | 17 +++++++++++++----
 2 files changed, 36 insertions(+), 4 deletions(-)

diff --git a/src/tests/video_core/fast_draw.cpp b/src/tests/video_core/fast_draw.cpp
index 6292ce60..4e2a8422 100644
--- a/src/tests/video_core/fast_draw.cpp
+++ b/src/tests/video_core/fast_draw.cpp
@@ -486,6 +486,29 @@ TEST_CASE("Fast draw breaks skip the add only on the drawing thread, after its f
     CHECK(current() == again + 1);
 }
 
+TEST_CASE("Syncs skip the add only on the thread that reads the sync serial, after its first",
+          "[fast_draw]") {
+    const auto current = [] { return FastDraw::g_sync_serial.load(std::memory_order_relaxed); };
+    const u64 read = FastDraw::SyncSerial();
+    FastDraw::Break(FastDraw::Reason::OtherEngine);
+    CHECK(current() == read + 1);
+    // More syncs before the next read change nothing the reader compares.
+    FastDraw::Break(FastDraw::Reason::OtherEngine);
+    FastDraw::NoteSync();
+    CHECK(current() == read + 1);
+    // A thread that never reads it (the front's puller) bumps every time.
+    std::thread other{[] {
+        FastDraw::NoteSync();
+        FastDraw::NoteSync();
+    }};
+    other.join();
+    CHECK(current() == read + 3);
+    const u64 again = FastDraw::SyncSerial();
+    CHECK(again == read + 3);
+    FastDraw::NoteSync();
+    CHECK(current() == again + 1);
+}
+
 TEST_CASE("Unsplit callbacks end draw reuse before they execute", "[fast_draw][unsplit_fast_draw]") {
     const bool previous_reads_serial = FastDraw::t_reads_serial;
     const bool previous_serial_bumped = FastDraw::t_serial_bumped;
diff --git a/src/video_core/nx2_fast_draw.h b/src/video_core/nx2_fast_draw.h
index b1e45ae2..814d220f 100644
--- a/src/video_core/nx2_fast_draw.h
+++ b/src/video_core/nx2_fast_draw.h
@@ -61,7 +61,8 @@ inline constexpr std::array<const char*, static_cast<size_t>(Reason::Count)> rea
     "memory map",
 };
 
-inline std::atomic<bool> g_enabled{true};
+/// Read by every thread: on its own cache line, away from the serials the breaks bump.
+alignas(64) inline std::atomic<bool> g_enabled{true};
 
 /// Whether pipelines take their vertex input as dynamic state (VK_EXT_vertex_input_dynamic_state):
 /// then the vertex attribute formats are draw parameters, as only each attribute's type class is
@@ -105,14 +106,22 @@ inline thread_local bool t_serial_bumped{};
 /// Bumped where the guest CPU may have synchronised with the GPU: fences, semaphores, syncpoints,
 /// reports, frames, other engines and requests from other threads. After one the guest may have
 /// written memory the caches were not told about (pages that aren't write-protected), so uniform
-/// keeps read their buffers again.
-inline std::atomic<u64> g_sync_serial{1};
+/// keeps read their buffers again. As with the serial above, the thread that reads it skips the
+/// locked add once it bumped it since that read (every method of another engine notes a sync).
+alignas(64) inline std::atomic<u64> g_sync_serial{1};
+inline thread_local bool t_reads_sync_serial{};
+inline thread_local bool t_sync_serial_bumped{};
 
 inline void NoteSync() {
-    g_sync_serial.fetch_add(1, std::memory_order_relaxed);
+    if (!(t_reads_sync_serial && t_sync_serial_bumped)) {
+        g_sync_serial.fetch_add(1, std::memory_order_relaxed);
+        t_sync_serial_bumped = t_reads_sync_serial;
+    }
 }
 
 [[nodiscard]] inline u64 SyncSerial() {
+    t_reads_sync_serial = true;
+    t_sync_serial_bumped = false;
     return g_sync_serial.load(std::memory_order_acquire);
 }
 
