         front_wake.wait(seen, std::memory_order_seq_cst);
     }
     front_waiting.store(false, std::memory_order_relaxed);
@@ -967,7 +973,8 @@ void GpuSplit::BackLoop(std::stop_token stop_token) {
                     if (idle_hook != nullptr) {
