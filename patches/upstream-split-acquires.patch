         }
@@ -717,15 +717,21 @@ void GpuSplit::Backoff(u32 spins, u64 target) {
         Pause();
         return;
     }
+    SleepForBack(target);
+}
+
+void GpuSplit::SleepForBack(u64 target, bool wait_for_idle) {
     if (!back_running.load(std::memory_order_acquire)) {
