From 8ee15beeec98840965d8a89677c5bb6672df7ba8 Mon Sep 17 00:00:00 2001
From: zortos293 <65777760+zortos293@users.noreply.github.com>
Date: Tue, 17 Nov 2026 23:16:31 +0000
Subject: [PATCH 1/9] video_core: pass equal and mask semaphore acquires on
 what their word settles at

An equal or mask acquire's word may go down, so only the value it holds once the
back ran everything sent so far decides one without a drain
(GpuSplit::SettledWordAt, the exactness rules of FrontQmdView::WordAt): the last
release noted there with a known payload and only noted releases to other words
after it, or memory once every write sent there ran and landed. Unknown words,
unnoted releases, the syncpoint shim and mirror-diverted words drain as before.
EDEN_NX2_ACQUIRE_STATS splits the remaining equal/mask drains by reason.

(cherry picked from commit 0ce91e0307fa666d090db0a42b1873d46397a1fc)
---
 src/tests/video_core/maxwell_fast_method.cpp | 175 +++++++++++++++++++
 src/video_core/engines/puller.cpp            |  39 +++--
 src/video_core/gpu_split.cpp                 |  48 ++++-
 src/video_core/gpu_split.h                   |  25 +++
 4 files changed, 272 insertions(+), 15 deletions(-)

diff --git a/src/tests/video_core/maxwell_fast_method.cpp b/src/tests/video_core/maxwell_fast_method.cpp
index e4967c50..3d7e1849 100644
--- a/src/tests/video_core/maxwell_fast_method.cpp
+++ b/src/tests/video_core/maxwell_fast_method.cpp
@@ -2363,6 +2363,181 @@ TEST_CASE("Split front passes an acquire on a QMD release the back ran before it
     CHECK(f.memory.Read<u32>(other) == 3);
 }
 
+TEST_CASE("Split front passes equal and mask acquires only on what their word settles at",
+          "[video_core][gpu_split_dependencies]") {
+    using Access = VideoCommon::GpuSplitTestAccess;
+    using Landing = VideoCommon::GpuSplit::Landing;
+    using MethodCall = Tegra::Engines::Puller::MethodCall;
+    using VideoCommon::AcquireUnsettled;
+    constexpr u32 Equal = 0x1;
+    constexpr u32 Mask = 0x8;
+    constexpr u32 OneWordRelease = 0x2 | (1U << 24);
+    constexpr GPUVAddr word = MappedPages::gpu_address + 0x1000;
+    constexpr DAddr word_device = MappedPages::device_address + 0x1000;
+    const auto fixture = std::make_unique<Fixture>();
+    Fixture& f = *fixture;
+    f.system.Initialize();
+    Tegra::Nx2ClearGpuWrittenPages();
+    MappedPages pages{f};
+    FencedReports fences{f.memory};
+    Tegra::Control::ChannelState channel_state{0};
+    Tegra::DmaPusher dma_pusher{f.system, f.memory, channel_state};
+    dma_pusher.BindRasterizer(&fences);
+    const auto accuracy = Settings::values.current_gpu_accuracy;
+    Settings::values.current_gpu_accuracy = Settings::GpuAccuracy::Low;
+    const bool ampere = Tegra::g_nx2_ampere.exchange(true);
+    const bool counting = std::exchange(VideoCommon::g_acquire_counting, true);
+    auto& split = VideoCommon::GpuSplit::Get();
+    std::atomic<bool> release{};
+    Access::Start(split, f.system);
+    Access::SetFrontMacros(split);
+    SCOPE_EXIT {
+        split.Stop();
+        VideoCommon::g_acquire_counting = counting;
+        Tegra::g_nx2_ampere = ampere;
+        Settings::values.current_gpu_accuracy = accuracy;
+    };
+    // Runs before Stop: a failed check must not leave the back in a held entry.
+    SCOPE_EXIT {
+        release = true;
+    };
+    const auto semaphore = [&](u32 payload, u32 trigger) {
+        const std::array<std::pair<u32, u32>, 4> methods{{
+            {0x4, static_cast<u32>(word >> 32)},
+            {0x5, static_cast<u32>(word)},
+            {0x6, payload},
+            {0x7, trigger},
+        }};
+        for (const auto& [method, argument] : methods) {
+            dma_pusher.puller.CallMethod(dma_pusher, MethodCall{method, argument});
+        }
+    };
+    // Whether the acquire passes at once, without the channel waiting.
+    const auto acquire = [&](u32 operation, u32 value) {
+        semaphore(value, operation);
+        return !dma_pusher.puller.HasPendingAcquire();
+    };
+    // A release the back runs now and writes once the test runs its fence, noted as \`known\`.
+    const auto fenced = [&](u32 payload, bool known, bool at_least) {
+        split.Defer(
+            [&fences, payload] {
+                fences.reports.push_back(
+                    {word, payload, VideoCommon::GpuSplit::Get().TrackFencedWrite()});
+            },
+            0, VideoCommon::GpuSplit::Writes::Noted);
+        split.NoteSemaphoreWrite(word_device, payload, known, at_least, Landing::Fenced);
+        split.Drain(VideoCommon::DrainSite::Other);
+    };
+    auto& stats = VideoCommon::g_acquire_stats;
+    const auto unsettled = [&](AcquireUnsettled why) {
+        return stats.unsettled[static_cast<size_t>(why)].load();
+    };
+    u64 drained = stats.drained.load();
+    u64 by_queued = stats.by_queued.load();
+    const auto drains = [&](u64 expected) {
+        const u64 now = stats.drained.load();
+        CHECK(now - drained == expected);
+        drained = now;
+    };
+
+    // Nothing sent there: memory decides.
+    f.memory.Write<u32>(word, 5);
+    CHECK(acquire(Equal, 5));
+    CHECK(acquire(Mask, 4));
+    drains(0);
+    // Not met by what the word settles at: it drains as before and waits. A poll passes once
+    // memory meets it, without a drain.
+    const u64 operations = stats.drain_operation.load();
+    CHECK_FALSE(acquire(Equal, 6));
+    CHECK(stats.drain_operation.load() == operations + 1);
+    drains(1);
+    f.memory.Write<u32>(word, 6);
+    CHECK(dma_pusher.puller.ResumeAcquire(dma_pusher));
+    drains(0);
+
+    // A release the back has yet to run, with a known payload: it decides, ordered after it. The
+    // back holds the entry before it until the test releases it, or an acquire drains.
+    split.Defer([&release, before = stats.drained.load()] {
+        while (VideoCommon::g_acquire_stats.drained.load() == before && !release.load()) {
+            std::this_thread::yield();
+        }
+    });
+    semaphore(7, OneWordRelease);
+    CHECK(acquire(Equal, 7));
+    CHECK(acquire(Mask, 3));
+    CHECK(stats.by_queued.load() == by_queued + 2);
+    by_queued += 2;
+    drains(0);
+    CHECK(f.memory.Read<u32>(word) == 6);
+    release = true;
+    split.Drain(VideoCommon::DrainSite::Other);
+    fences.RunFence();
+    CHECK(f.memory.Read<u32>(word) == 7);
+
+    // The back ran a release whose fence has yet to run: its payload decides, not memory.
+    fenced(8, true, false);
+    CHECK(acquire(Equal, 8));
+    CHECK(stats.by_queued.load() == by_queued + 1);
+    drains(0);
+    CHECK(acquire(Equal, 7)); // Memory meets it, until the release lands: it drains
+    drains(1);
+    fences.RunFence();
+
+    // A queued release of unknown value, or of a lower bound: memory may change under it.
+    const u64 unknown = unsettled(AcquireUnsettled::Unknown);
+    fenced(9, false, false);
+    CHECK(acquire(Equal, 8));
+    drains(1);
+    fences.RunFence();
+    fenced(10, true, true);
+    CHECK(acquire(Mask, 1));
+    drains(1);
+    fences.RunFence();
+    CHECK(unsettled(AcquireUnsettled::Unknown) == unknown + 2);
+    CHECK(f.memory.Read<u32>(word) == 10);
+
+    // A release the front did not note may land yet.
+    const u64 unnoted = unsettled(AcquireUnsettled::Unnoted);
+    split.Defer(
+        [&fences] {
+            fences.reports.push_back(
+                {word + 0x10, 2, VideoCommon::GpuSplit::Get().TrackFencedWrite()});
+        },
+        0, VideoCommon::GpuSplit::Writes::Noted);
+    split.NoteUnnotedReleases();
+    split.Drain(VideoCommon::DrainSite::Other);
+    CHECK(acquire(Equal, 10));
+    drains(1);
+    CHECK(unsettled(AcquireUnsettled::Unnoted) == unnoted + 1);
+    fences.RunFence();
+
+    // Another write sent there that the back has yet to run (held until the acquire drains).
+    const u64 writes = unsettled(AcquireUnsettled::Writes);
+    release = false;
+    split.Defer(
+        [&release, before = stats.drained.load()] {
+            while (VideoCommon::g_acquire_stats.drained.load() == before && !release.load()) {
+                std::this_thread::yield();
+            }
+        },
+        0, VideoCommon::GpuSplit::Writes::Noted);
+    split.NoteWrite(f.memory, word, sizeof(u32));
+    split.Publish();
+    CHECK(acquire(Equal, 10));
+    drains(1);
+    CHECK(unsettled(AcquireUnsettled::Writes) == writes + 1);
+
+    // GPU acquires read a word mirrored releases go beside from the mirror shadow.
+    const u64 elsewhere = unsettled(AcquireUnsettled::Elsewhere);
+    Tegra::Nx2AddSemaphoreRegion(word & ~GPUVAddr{0xfff});
+    Tegra::Nx2MirrorShadow::Get().NoteDirectRelease(word_device, word);
+    CHECK(acquire(Equal, 10));
+    drains(1);
+    CHECK(unsettled(AcquireUnsettled::Elsewhere) == elsewhere + 1);
+    Tegra::Nx2MirrorShadow::Get().Clear();
+    Tegra::Nx2RemoveSemaphoreRegion(word & ~GPUVAddr{0xfff});
+}
+
 TEST_CASE("Split front sends state writes to the back as register blocks that match single writes",
           "[video_core][gpu_split_dependencies]") {
     using Access = VideoCommon::GpuSplitTestAccess;
diff --git a/src/video_core/engines/puller.cpp b/src/video_core/engines/puller.cpp
index 282d4164..94409941 100644
--- a/src/video_core/engines/puller.cpp
+++ b/src/video_core/engines/puller.cpp
@@ -123,19 +123,18 @@ enum class AcquireCheck {
     Drain,       ///< Drain the split and read the word as before
 };
 
-// Checks a greater-or-equal acquire without draining the split. The words Switch 2 syncs on only
-// advance (NVN2 even releases QMD completions as maxima, KeplerCompute::ProcessNativeMethod), so
-// a value that meets one now still does once the back ran the queued work. Only the last release
-// the front sent to the word decides instead, when the back may not have run it yet: MetByQueued
-// sets `release` to the position the back runs it by.
+// Checks an acquire without draining the split. The words Switch 2 syncs on only advance (NVN2
+// even releases QMD completions as maxima, KeplerCompute::ProcessNativeMethod), so a value that
+// meets a greater-or-equal acquire now still does once the back ran the queued work. Only the last
+// release the front sent to the word decides instead, when the back may not have run it yet:
+// MetByQueued sets `release` to the position the back runs it by. An equal or mask acquire's word
+// may also go down: only what it holds once the back ran everything sent so far decides one
+// (GpuSplit::SettledWordAt), and where the front can't tell that, or it doesn't meet it, it
+// drains as before.
 AcquireCheck CheckWithoutDrain(DmaPusher& dma_pusher, const Puller::PendingAcquire& acquire,
                                u64& release) {
     auto& split = VideoCommon::GpuSplit::Get();
     auto& stats = VideoCommon::g_acquire_stats;
-    if (!acquire.WaitsToReach()) {
-        VideoCommon::Count(stats.drain_operation);
-        return AcquireCheck::Drain;
-    }
     if (!split.Active() || !split.FrontMacros() || !ReleasesLandAtOnce()) {
         VideoCommon::Count(stats.drain_settings);
         return AcquireCheck::Drain;
@@ -146,6 +145,23 @@ AcquireCheck CheckWithoutDrain(DmaPusher& dma_pusher, const Puller::PendingAcqui
         VideoCommon::Count(stats.drain_word);
         return AcquireCheck::Drain;
     }
+    if (!acquire.WaitsToReach()) {
+        VideoCommon::AcquireUnsettled why{};
+        const auto settled =
+            split.SettledWordAt(dma_pusher.memory_manager, acquire.address, *device, why);
+        if (settled && acquire.Matches(settled->value)) {
+            if (!settled->release) {
+                return AcquireCheck::Met;
+            }
+            release = *settled->release;
+            return AcquireCheck::MetByQueued;
+        }
+        VideoCommon::Count(stats.drain_operation);
+        if (!settled) {
+            VideoCommon::Count(stats.unsettled[static_cast<size_t>(why)]);
+        }
+        return AcquireCheck::Drain;
+    }
     if (const auto queued = split.QueuedSemaphoreWriteAt(*device)) {
         if (queued->known && acquire.Matches(queued->payload)) {
             release = queued->position;
@@ -201,9 +217,10 @@ void VerifyWithoutDrain(DmaPusher& dma_pusher, const Puller::PendingAcquire& acq
     VideoCommon::Count(stats.mismatches);
     if (static std::atomic<u32> logged{}; logged.fetch_add(1) < 16) {
         LOG_WARNING(HW_GPU,
-                    "Acquire verify: channel {} passed semaphore {:#x} (>= {:#x}) without a "
+                    "Acquire verify: channel {} passed semaphore {:#x} (op {}, {:#x}) without a "
                     "drain, the word is {:#x} after it",
-                    dma_pusher.channel_state.bind_id, acquire.address, acquire.value, word);
+                    dma_pusher.channel_state.bind_id, acquire.address, acquire.operation,
+                    acquire.value, word);
     }
 }
 
diff --git a/src/video_core/gpu_split.cpp b/src/video_core/gpu_split.cpp
index 88871c93..45841e20 100644
--- a/src/video_core/gpu_split.cpp
+++ b/src/video_core/gpu_split.cpp
@@ -402,6 +402,39 @@ std::optional<GpuSplit::QueuedSemaphoreWrite> GpuSplit::QueuedSemaphoreWriteAt(
                                 it->second.fenced, it->second.position};
 }
 
+std::optional<GpuSplit::SettledWord> GpuSplit::SettledWordAt(const Tegra::MemoryManager& memory,
+                                                             GPUVAddr address, u64 device_address,
+                                                             AcquireUnsettled& why) const {
+    auto& shadow = Tegra::Nx2MirrorShadow::Get();
+    // Mirrored releases into a diverted word change what acquires read there without a note.
+    if (memory.OverlapsSyncpointShim(address, sizeof(u32)) || shadow.Diverts(device_address)) {
+        why = AcquireUnsettled::Elsewhere;
+        return std::nullopt;
+    }
+    if (!UnnotedReleasesLanded()) {
+        why = AcquireUnsettled::Unnoted;
+        return std::nullopt;
+    }
+    const u64 others = OtherWritesTarget(memory, address);
+    if (const auto queued = QueuedSemaphoreWriteAt(device_address)) {
+        if (!queued->known || queued->at_least) {
+            why = AcquireUnsettled::Unknown;
+            return std::nullopt;
+        }
+        if (queued->position < others) {
+            why = AcquireUnsettled::Writes;
+            return std::nullopt;
+        }
+        return SettledWord{queued->payload, queued->position};
+    }
+    if (!Ran(others)) {
+        why = AcquireUnsettled::Writes;
+        return std::nullopt;
+    }
+    const u32 guest = memory.Read<u32>(address);
+    return SettledWord{shadow.Read(device_address, guest).value_or(guest), std::nullopt};
+}
+
 GpuSplit::FencedHold GpuSplit::TrackFencedWrite() {
     if (!on_back_thread) {
         return {};
@@ -995,6 +1028,10 @@ void GpuSplit::ReportAcquire() {
     const u64 latched = take(stats.latched);
     const u64 drained = take(stats.drained);
     const u64 drain_operation = take(stats.drain_operation);
+    std::array<u64, static_cast<size_t>(AcquireUnsettled::Count)> unsettled{};
+    for (size_t why = 0; why < unsettled.size(); ++why) {
+        unsettled[why] = take(stats.unsettled[why]);
+    }
     const u64 drain_settings = take(stats.drain_settings);
     const u64 drain_word = take(stats.drain_word);
     const u64 drain_queued = take(stats.drain_queued);
@@ -1019,14 +1056,17 @@ void GpuSplit::ReportAcquire() {
     const double spin_ms = static_cast<double>(take(stats.back_spin_ns)) / 1e6;
     LOG_INFO(HW_GPU,
              "Acquires: {} passed without a drain ({} by a queued release), {} resumed by a "
-             "latch, {} drained ({} by the 1 ms valve; {} equal or mask, {} by the settings, {} "
+             "latch, {} drained ({} by the 1 ms valve; {} equal or mask (of them on a word queued "
+             "work may still change: {} read elsewhere, {} released an unknown value, {} with "
+             "other writes queued, {} with unnoted releases), {} by the settings, {} "
              "unmapped or GPU-written word, {} queued release unknown or short), {} polls waited "
              "without a drain in 10 s; polls: {} of acquires, {} of GPU-written list copies; "
              "back: {} waits for work, {} slept, {:.1f} ms spinning; {} early publishes, {} idle "
              "hooks asked by polls",
-             passed, by_queued, latched, drained, valve_drains, drain_operation, drain_settings,
-             drain_word, drain_queued, polls, acquire_polls, list_polls, back_waits, back_sleeps,
-             spin_ms, early_publishes, settles);
+             passed, by_queued, latched, drained, valve_drains, drain_operation, unsettled[0],
+             unsettled[1], unsettled[2], unsettled[3], drain_settings, drain_word, drain_queued,
+             polls, acquire_polls, list_polls, back_waits, back_sleeps, spin_ms, early_publishes,
+             settles);
     LOG_INFO(HW_GPU,
              "GPU thread waits for suspended channels in 10 s: {} in hardware, {} in the OS, {} "
              "ended by a wake, {} by a store to a semaphore word; channels that moved without "
diff --git a/src/video_core/gpu_split.h b/src/video_core/gpu_split.h
index c0f4bfef..0b63713f 100644
--- a/src/video_core/gpu_split.h
+++ b/src/video_core/gpu_split.h
@@ -61,6 +61,16 @@ enum class DrainSite : u32 {
     Count,
 };
 
+/// Why the front can't tell what an equal or mask acquire's word holds once the back ran what was
+/// sent (GpuSplit::SettledWordAt), counted with the acquires.
+enum class AcquireUnsettled : u32 {
+    Elsewhere, ///< Acquires read it from the syncpoint shim or the mirror shadow
+    Unknown,   ///< The last release noted there has an unknown value or a lower bound
+    Writes,    ///< The back has yet to run another write sent there, or one after the note
+    Unnoted,   ///< A release the front did not note may land yet
+    Count,
+};
+
 /// Why the front's QMD view lost its table (FrontQmdView), counted with the acquires.
 enum class QmdLoss : u32 {
     Mappings,     ///< A change of the GPU's mappings may change what the back reads
@@ -91,6 +101,8 @@ struct AcquireStats {
     std::atomic<u64> latched{};   ///< Polls resumed by a release the back ran (no drain)
     std::atomic<u64> drained{};   ///< Acquires and polls that drained the split
     std::atomic<u64> drain_operation{}; ///< Of drained: an equal or mask acquire
+    /// Of drain_operation: those whose word queued work may still change, by why
+    std::array<std::atomic<u64>, static_cast<size_t>(AcquireUnsettled::Count)> unsettled{};
     std::atomic<u64> drain_settings{};  ///< ...the split or the accuracy settings ask for it
     std::atomic<u64> drain_word{};      ///< ...the word is unmapped or on a GPU-written page
     std::atomic<u64> drain_queued{};    ///< ...a queued release to it is unknown or doesn't meet it
@@ -466,6 +478,19 @@ public:
     /// yet.
     [[nodiscard]] std::optional<QueuedSemaphoreWrite> QueuedSemaphoreWriteAt(
         u64 device_address) const;
+    struct SettledWord {
+        u32 value;
+        std::optional<u64> release; ///< The position the back runs the noted release by
+    };
+    /// What an acquire of the word at `address` (`device_address`) finds once the back ran
+    /// everything sent so far, where the front knows that exactly, as FrontQmdView::WordAt values
+    /// a reduction's base: the last release noted there, with a known payload and only noted
+    /// releases to other words sent after it; or memory, once the back ran every write sent there
+    /// and each landed. None, with `why`, where queued work may still change it or acquires read
+    /// it elsewhere. Every release the front did not note must have landed for either.
+    [[nodiscard]] std::optional<SettledWord> SettledWordAt(const Tegra::MemoryManager& memory,
+                                                           GPUVAddr address, u64 device_address,
+                                                           AcquireUnsettled& why) const;
     /// A release just sent writes `size` bytes from `device_address` that the front does not
     /// value (a report's timestamp, a mirrored release): noted word by word as unknown, so that
     /// nothing takes memory there for what the back finds until they landed.
